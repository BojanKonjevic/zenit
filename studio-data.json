{
  "version": "1.1.2",
  "templates": [
    {
      "id": "blank",
      "name": "blank",
      "desc": "blank: dev tools only (pytest, ruff, mypy)"
    },
    {
      "id": "fastapi",
      "name": "fastapi",
      "desc": "fastapi: FastAPI web framework skeleton"
    }
  ],
  "addons": [
    {
      "id": "auth-manual",
      "name": "auth-manual",
      "desc": "JWT auth: register, login, refresh, logout, current user",
      "tags": [
        "auth"
      ],
      "requires": [
        "sqlalchemy"
      ],
      "conflicts": [],
      "templates": [
        "fastapi"
      ],
      "col": "#c8922e",
      "files": [
        "src/((pkg_name))/core/security.py",
        "src/((pkg_name))/core/dependencies.py",
        "src/((pkg_name))/models/user.py",
        "src/((pkg_name))/models/refresh_token.py",
        "src/((pkg_name))/schemas/auth.py",
        "src/((pkg_name))/api/routes/auth.py",
        "tests/integration/test_auth.py"
      ],
      "envVars": [
        "SECRET_KEY",
        "ACCESS_TOKEN_EXPIRE_MINUTES",
        "REFRESH_TOKEN_EXPIRE_DAYS"
      ],
      "deps": [
        "bcrypt",
        "pyjwt",
        "email-validator",
        "python-multipart",
        "python-dotenv"
      ],
      "devDeps": [],
      "composeServices": [],
      "recipes": [
        "gen-secret"
      ],
      "injections": [
        "settings_fields → secret_key",
        "router_imports → router as auth_router",
        "router_includes → api_router.include_router",
        "test_imports → User",
        "test_fixtures → pytest.fixture",
        "model_imports → User",
        "exceptions → class"
      ]
    },
